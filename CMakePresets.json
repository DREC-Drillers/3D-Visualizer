{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "VISUALIZER_BUILD_EXAMPLES": true,
        "VISUALIZER_BUILD_OPENGL_TESTS": false
      }
    },
    {
      "name": "debug",
      "displayName": "Debug library, example and unit tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true,
        "VISUALIZER_BUILD_TESTS": true
      }
    },
    {
      "name": "release",
      "displayName": "Release library and example",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false,
        "VISUALIZER_BUILD_TESTS": false
      }
    },
    {
      "name": "profile",
      "displayName": "Optimized library and example with debug symbols",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "quality",
      "displayName": "Compilation database for clang-tidy",
      "inherits": "debug",
      "cacheVariables": {
        "VISUALIZER_BUILD_OPENGL_TESTS": true
      }
    },
    {
      "name": "opengl",
      "displayName": "OpenGL rendering integration tests",
      "inherits": "debug",
      "cacheVariables": {
        "VISUALIZER_BUILD_OPENGL_TESTS": true,
        "VISUALIZER_BUILD_EXAMPLES": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 2
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 2
    },
    {
      "name": "profile",
      "configurePreset": "profile",
      "jobs": 2
    },
    {
      "name": "quality",
      "configurePreset": "quality",
      "jobs": 2
    },
    {
      "name": "opengl",
      "configurePreset": "opengl",
      "targets": [
        "visualizer_opengl_tests"
      ],
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "quality",
      "configurePreset": "quality",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "exclude": {
          "label": "opengl"
        }
      }
    },
    {
      "name": "opengl",
      "configurePreset": "opengl",
      "filter": {
        "include": {
          "label": "opengl"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
